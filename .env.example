# Copie este arquivo para .env. Não coloque segredos aqui.
COMPOSE_PROJECT_NAME=lustre_decor
APP_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=backend,localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=lustre_decor
POSTGRES_USER=lustre_app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
LOG_LEVEL=INFO
# Alertas de segurança por e-mail (força bruta bloqueada, acesso a objeto de
# outro usuário) — vão pro Mailpit local (http://127.0.0.1:8025) por padrão.
# Formato: "Nome:email@exemplo.com,Outro Nome:outro@exemplo.com". Vazio =
# alertas desligados (não quebra nada). Ver docs/security.md.
# DJANGO_ADMINS=Segurança:voce@exemplo.com
ENABLE_OIDC=false
# OIDC_RP_CLIENT_ID=lustredecor-app
# OIDC_RP_CLIENT_SECRET=seu-secret-aqui
# OIDC_OP_AUTHORIZATION_ENDPOINT=http://keycloak:8080/auth/realms/lustredecor/protocol/openid-connect/auth
# OIDC_OP_TOKEN_ENDPOINT=http://keycloak:8080/auth/realms/lustredecor/protocol/openid-connect/token
# OIDC_OP_USER_ENDPOINT=http://keycloak:8080/auth/realms/lustredecor/protocol/openid-connect/userinfo
# OIDC_OP_JWKS_ENDPOINT=http://keycloak:8080/auth/realms/lustredecor/protocol/openid-connect/certs

