# Vhost do Lustre Decor para a imagem owasp/modsecurity-crs:nginx. O
# ModSecurity + OWASP CRS já é habilitado globalmente por
# /etc/nginx/templates/conf.d/modsecurity.conf.template (não tocado aqui) —
# roda antes de qualquer location abaixo, sem precisar repetir nada aqui.
#
# Arquivo processado por envsubst no entrypoint da imagem (por isso a
# extensão .template) — usa ${WAF_EXTRA_HOST} e ${BACKEND_UPSTREAM} de
# propósito (substituídos na inicialização); todo o resto é texto nginx
# normal ($http_host, $host etc., sem chaves), que o envsubst não toca. Ver
# nginx/Dockerfile.

# Rate limiting adicional no login, em complemento ao throttling do DRF
# (defesa em profundidade — ver docs/security.md).
limit_req_zone $binary_remote_addr zone=login_limit:10m rate=5r/m;
# Segunda etapa do login (código TOTP / backup). Um pouco mais folgado que o
# login — o usuário pode errar a digitação — mas ainda inviabiliza força bruta
# nos 10^6 códigos (o backend também descarta o desafio após 5 erros).
limit_req_zone $binary_remote_addr zone=mfa_limit:10m rate=10r/m;
limit_req_status 429;

# Access log dedicado ao Fail2ban (e ao agente Wazuh) — arquivo em
# /var/log/lustre-waf, montado do host na DMZ (ver docker-compose.dmz.yml e
# infra/fail2ban/). Campos fixos PRIMEIRO, ancorados pelos filtros:
#   $remote_addr        IP da conexão TCP (o cliente não forja; na DMZ não há
#                       proxy na frente — Compose puro, sem routing mesh);
#   $status             status devolvido ao cliente;
#   upstream=$upstream_status
#                       "-" quando a resposta nasceu no próprio waf
#                       (ModSecurity 403, limit_req 429, estático do SPA) —
#                       é isso que separa um bloqueio do WAF de um 403 do Django.
# Tudo que o cliente controla (URI, User-Agent) vem depois, entre aspas, com o
# escape padrão do Nginx (\x22 para aspas).
log_format lustre_f2b '$remote_addr [$time_iso8601] $status upstream=$upstream_status '
                      '"$request_method $uri" rt=$request_time ua="$http_user_agent"';

# Allowlist do cabeçalho Host encaminhado ao backend: nunca repassar o valor
# enviado pelo cliente sem validar (Host header injection — achado real do
# Semgrep, regra generic.nginx.security.request-host-used, corrigido em
# 2026-09-05). Só os hosts locais usados neste laboratório são aceitos.
# Falso positivo revisado: o cabeçalho recebido aqui só decide um booleano
# (0/1) contra uma allowlist explícita — o valor em si nunca é repassado sem
# essa checagem (ver `if ($host_allowed = 0)` abaixo e nginx/proxy_params.conf).
# ${WAF_EXTRA_HOST}: host(:porta) adicional pro ambiente onde isso rodar de
# verdade (ex.: o IP da VM do lab) — definido via env var no compose, vazio
# por padrão (vira uma entrada "" que nunca combina com um Host de verdade,
# então não afeta nada quando não usado). Ver docker-compose.prod.yml.
map $http_host $host_allowed { # nosemgrep: generic.nginx.security.request-host-used.request-host-used
    default             0;
    "localhost:8443"    1;
    "127.0.0.1:8443"    1;
    "localhost"         1;
    "127.0.0.1"         1;
    "${WAF_EXTRA_HOST}" 1;
}

# Porta do redirecionamento HTTP -> HTTPS. Depende de como o cliente chegou:
#   - Host COM porta (ex.: localhost:8080 no perfil local, onde o HTTPS é
#     publicado em 8443): redireciona para :8443.
#   - Host SEM porta (ex.: 192.168.9.34 na DMZ, onde o host publica 80/443):
#     redireciona sem porta (443 padrão). Antes o 8443 era fixo e, na DMZ,
#     mandava o navegador para uma porta que o host não publica.
map $http_host $https_redirect_port {
    default     "";
    "~:[0-9]+$" ":8443";
}

# Porta 8080: só redireciona para HTTPS. Não serve app nem estático — nenhum
# dado sensível trafega aqui, então dispensa a allowlist/headers abaixo.
server {
    listen 8080;
    server_name _;
    server_tokens off;
    return 301 https://$host$https_redirect_port$request_uri;
}

server {
    listen 8443 ssl;
    server_name _;

    # Certificado autoassinado para uso local (ver README — "TLS local").
    # Não é adequado para um domínio público de verdade: nesse caso a origem
    # do certificado passa a ser uma CA confiável (ex.: Let's Encrypt), uma
    # decisão arquitetural própria fora do escopo deste laboratório.
    ssl_certificate /run/secrets/tls_cert;
    ssl_certificate_key /run/secrets/tls_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    server_tokens off;

    # access_log no nível do server substitui o herdado do http (o "main" da
    # imagem base, que vai para o stdout): por isso os dois aqui — arquivo para
    # o Fail2ban/Wazuh e stdout para o `docker logs` continuar funcionando.
    # ("combined" é o formato pré-definido do Nginx; o "main" da imagem base
    # ainda não existe neste ponto da leitura dos conf.d.)
    access_log /var/log/lustre-waf/access.log lustre_f2b;
    access_log /var/log/nginx/access.log combined;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 1m;

    if ($host_allowed = 0) {
        return 400;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()" always;
    # style/script-src permitem cdnjs.cloudflare.com: a tela de login do
    # django-two-factor-auth carrega Bootstrap/jQuery de lá (verificado em
    # 2026-09-05). O restante da aplicação (SPA React) usa só same-origin.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    # Sem Strict-Transport-Security aqui de propósito: com certificado
    # autoassinado, HSTS impede o navegador de deixar você "prosseguir mesmo
    # assim" no aviso de certificado, travando o acesso local. Cabe ativar
    # quando houver um certificado de CA confiável (ver nota acima).

    # /healthz (healthcheck do container) e /metrics/nginx (stub_status,
    # restrito por IP) vêm da própria imagem base — ver
    # includes/location_common.conf.template.
    include includes/location_common.conf;

    # Artefatos estáticos do Django (admin, two-factor). Servidos pelo
    # próprio backend via WhiteNoise (não por um volume compartilhado) —
    # funciona igual com o waf e o backend no mesmo host ou em VMs
    # separadas (ver docker-compose.dmz.yml). Ver backend/config/settings/base.py.
    location /static/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        include /etc/nginx/proxy_params.conf;
    }

    # ${BACKEND_UPSTREAM}: host:porta do backend — "backend:8000" (nome do
    # serviço Docker) quando os dois estão no mesmo host/rede, ou um IP:porta
    # de verdade (ex.: 192.168.9.50:8000) quando estão em VMs separadas. Ver
    # docker-compose.prod.yml (padrão) e docker-compose.dmz.yml (duas VMs).
    location = /api/v1/auth/login/ {
        limit_req zone=login_limit burst=3 nodelay;
        proxy_pass http://${BACKEND_UPSTREAM};
        include /etc/nginx/proxy_params.conf;
    }

    location = /api/v1/auth/mfa/verify/ {
        limit_req zone=mfa_limit burst=5 nodelay;
        proxy_pass http://${BACKEND_UPSTREAM};
        include /etc/nginx/proxy_params.conf;
    }

    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        include /etc/nginx/proxy_params.conf;
    }

    location /admin/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        include /etc/nginx/proxy_params.conf;
    }

    # Sprint 2 (Zero Trust) — forward-auth, desativado. Antes de descomentar,
    # trocar o `return 200` de /auth pelo proxy_pass ao Authelia: do jeito
    # que está abaixo ele aprovaria qualquer requisição.
    # location /api/admin/ {
    #   auth_request /auth;
    #   proxy_pass http://backend:8000;
    # }
    # location = /auth {
    #   return 200;
    # }

    location /account/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        include /etc/nginx/proxy_params.conf;
    }

    # SPA: rotas do React Router (ex.: /produtos/5) devem cair no index.html.
    location / {
        try_files $uri /index.html;
    }
}
