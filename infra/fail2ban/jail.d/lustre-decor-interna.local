# Fail2ban — host interno (192.168.9.50). Instalado por
# infra/scripts/install-fail2ban.sh interna. Ver docs/deteccao.md.
#
# Só SSH: a aplicação não é publicada para fora a partir deste host (o
# backend só é alcançado pela DMZ via pfSense, e o login é tratado na DMZ).
# O SSH alcançável a partir da DMZ foi achado no T02 — até a regra do
# pfSense ser corrigida, o fail2ban é a linha de defesa contra força bruta
# nessa porta.

[DEFAULT]
# A .34 (DMZ) NÃO entra aqui de propósito: força bruta de SSH vinda da DMZ é
# justamente o cenário do T02 e deve ser banida. Por isso os bans desta VM
# valem SÓ para a porta 22 (ver recidive abaixo) — um ban em todas as portas
# cortaria o tráfego legítimo waf (.34) -> backend (.50:8000).
ignoreip = 127.0.0.1/8 ::1 192.168.9.50 __IGNOREIP__

[sshd]
enabled  = true
backend  = systemd
maxretry = 5
findtime = 10m
bantime  = 1h

[recidive]
enabled  = true
backend  = auto
# Só SSH (o padrão do recidive bloqueia todas as portas — ver comentário do ignoreip).
banaction = nftables[type=multiport]
port     = ssh
logpath  = /var/log/fail2ban.log
maxretry = 3
findtime = 1d
bantime  = 1w
