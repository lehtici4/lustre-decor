#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Resposta ativa do Lustre Decor para alertas do Falco (Wazuh active response).

Roda no AGENTE do host onde o Falco disparou (location "local" no ossec.conf
do manager), como root, chamado pelo wazuh-execd. Instalado em
/var/ossec/active-response/bin/lustre-falco-ar por
infra/scripts/install-wazuh-agent.sh. Só usa a biblioteca padrão do Python.

Ação por regra (o script decide pela regra do Falco; ver docs/wazuh.md):

  100210 shell em container             \
  100211 docker.sock / privilegiado      |  coleta evidência (container
  100212 secret lido                     |  congelado com pause) e recria o
  100214 ferramenta de rede em container /  container a partir da imagem
  100214 conexão de saída p/ IP público  -> DROP do IP de destino na chain
                                            DOCKER-USER (o execd remove após
                                            o timeout com "delete")
  100213 tentativa de parar sensor       -> religa Falco/Fail2ban
  (demais regras do 100213)              -> nenhuma ação
  100230 Falco travado ou parado         -> reinicia o Falco (máx. 1 vez por hora)

Recriar = Swarm: `docker kill` na tarefa, o Swarm sobe outra do zero.
          Compose: `docker compose up -d --force-recreate --no-deps <serviço>`.
Nos dois casos a camada gravável do container (onde ficaria o que o atacante
deixou) é descartada; a evidência fica em /var/ossec/logs/lustre-ar/.

Salvaguardas:
  - só age em containers do Lustre Decor (nome começa com "lustre_decor");
    exceção: container PRIVILEGIADO de qualquer nome, menos os do Wazuh;
  - no máximo 3 recriações por serviço a cada 15 min (evita laço de
    kill/recria se uma regra der falso positivo na inicialização);
  - bloqueio de saída só para IP público (nunca rede interna/DMZ);
  - protocolo check_keys do execd (Wazuh >= 4.2): sem resposta = não age.

Cada ação vira uma linha JSON em /var/ossec/logs/lustre-ar.log, coletada pelo
agente (lustre-common.conf) -> regras 100220-100225 no manager.
"""
import datetime
import fcntl
import ipaddress
import json
import os
import re
import select
import subprocess
import sys
import tempfile
import time

NAME = "lustre-falco-ar"
LOG_FILE = "/var/ossec/logs/lustre-ar.log"
EVIDENCE_ROOT = "/var/ossec/logs/lustre-ar"
STATE_FILE = "/var/ossec/var/run/lustre-ar-state.json"

APP_PREFIX = "lustre_decor"
PROTECTED_PREFIXES = ("wazuh_", "wazuh.")
RATE_MAX = 3
RATE_WINDOW = 900  # s
CHAIN = "DOCKER-USER"
COMMENT = "lustre-ar"
SENSOR_UNITS = ("falco-modern-bpf", "falco", "fail2ban")
HANDSHAKE_TIMEOUT = 30  # s
CMD_TIMEOUT = 60  # s

# O execd não garante PATH; os binários usados ficam nestes diretórios.
os.environ["PATH"] = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"


# ---------------------------------------------------------------------------
# utilitários
# ---------------------------------------------------------------------------
def now():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def log(event, **fields):
    """Uma linha JSON por evento. O_APPEND, nunca O_TRUNC: truncar arquivo em
    /var/ossec/logs dispararia a regra do Falco de log truncado."""
    rec = {"lustre_ar": event, "ar_time": now()}
    rec.update({k: ("" if v is None else str(v)) for k, v in fields.items()})
    line = (json.dumps(rec, ensure_ascii=False) + "\n").encode("utf-8")
    try:
        fd = os.open(LOG_FILE, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o640)
        try:
            os.write(fd, line)
        finally:
            os.close(fd)
    except OSError:
        pass


def run(cmd, cwd=None, timeout=CMD_TIMEOUT):
    try:
        p = subprocess.run(cmd, cwd=cwd, timeout=timeout, stdin=subprocess.DEVNULL,
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        return p.returncode, p.stdout.decode("utf-8", "replace"), p.stderr.decode("utf-8", "replace")
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, "", str(e)


def lookup(obj, dotted):
    """Busca um campo do alerta aceitando as duas formas em que o Wazuh pode
    entregar os campos do Falco: aninhado (output_fields -> container -> name)
    ou com ponto na chave (output_fields -> "container.name")."""
    if not dotted:
        return obj
    if not isinstance(obj, dict):
        return None
    if dotted in obj:
        return obj[dotted]
    parts = dotted.split(".")
    for i in range(len(parts) - 1, 0, -1):
        head = ".".join(parts[:i])
        if head in obj:
            found = lookup(obj[head], ".".join(parts[i:]))
            if found is not None:
                return found
    return None


def from_output(alert, label):
    """Fallback: extrai `label=valor` do texto do alerta do Falco."""
    text = lookup(alert, "data.output") or ""
    m = re.search(r"\b%s=(\S+)" % re.escape(label), text)
    return m.group(1) if m else None


def falco_field(alert, falco_name, label):
    value = lookup(alert, "data.output_fields." + falco_name)
    if value in (None, "", "<NA>"):
        value = from_output(alert, label)
    if value in (None, "", "<NA>", "host"):
        return None
    return str(value)


# ---------------------------------------------------------------------------
# protocolo do wazuh-execd
# ---------------------------------------------------------------------------
def check_keys(keys):
    """Pergunta ao execd se pode seguir (ele aborta se já existe uma resposta
    ativa com as mesmas chaves). Sem resposta em 30 s = não age."""
    msg = {"version": 1, "origin": {"name": NAME, "module": "active-response"},
           "command": "check_keys", "parameters": {"keys": keys}}
    try:
        sys.stdout.write(json.dumps(msg) + "\n")
        sys.stdout.flush()
        ready, _, _ = select.select([sys.stdin], [], [], HANDSHAKE_TIMEOUT)
        if not ready:
            return "timeout"
        reply = json.loads(sys.stdin.readline() or "{}")
        return reply.get("command", "")
    except (OSError, ValueError) as e:
        return "erro: %s" % e


def detach():
    """Libera o execd (que espera o script terminar) e continua em segundo
    plano: coleta de evidência e recriação levam alguns segundos."""
    sys.stdout.flush()
    if os.fork() > 0:
        os._exit(0)
    os.setsid()
    if os.fork() > 0:
        os._exit(0)
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)


# ---------------------------------------------------------------------------
# decisão
# ---------------------------------------------------------------------------
def decide(rule_id, falco_rule):
    if rule_id == "100230":
        return "falco_restart"
    if rule_id == "100213":
        if falco_rule.startswith("LustreDecor - Tentativa de parar sensor"):
            return "sensor"
        return None
    if rule_id == "100214" and falco_rule.startswith("LustreDecor - Conexao de saida"):
        return "egress"
    if rule_id in ("100210", "100211", "100212", "100214"):
        return "contain"
    return None


# ---------------------------------------------------------------------------
# recriar container
# ---------------------------------------------------------------------------
def rate_limited(key, maximo=RATE_MAX, janela=RATE_WINDOW):
    """True se `key` já teve `maximo` ações na janela. Registra a ação."""
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    fd = os.open(STATE_FILE, os.O_RDWR | os.O_CREAT, 0o600)
    with os.fdopen(fd, "r+") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        try:
            state = json.loads(f.read() or "{}")
        except ValueError:
            state = {}
        t = time.time()
        hist = [x for x in state.get(key, []) if t - x < janela]
        limited = len(hist) >= maximo
        if not limited:
            hist.append(t)
        state[key] = hist
        state = {k: v for k, v in state.items() if v}
        f.seek(0)
        f.truncate()
        f.write(json.dumps(state))
    return limited


def write_evidence(directory, name, content):
    # O_EXCL e sem O_TRUNC (ver log()).
    fd = os.open(os.path.join(directory, name), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(content)


def collect_evidence(cid, cname, alert):
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    os.makedirs(EVIDENCE_ROOT, mode=0o700, exist_ok=True)
    # mkdtemp: nome único (rajada de alertas no mesmo segundo) e modo 0700.
    directory = tempfile.mkdtemp(prefix="%s_%s_" % (stamp, re.sub(r"[^A-Za-z0-9_.-]", "_", cname)),
                                 dir=EVIDENCE_ROOT)
    write_evidence(directory, "alert.json", json.dumps(alert, indent=2, ensure_ascii=False))
    for fname, cmd in (
        ("inspect.json", ["docker", "inspect", cid]),
        ("top.txt", ["docker", "top", cid, "-eo", "pid,ppid,user,etime,args"]),
        ("diff.txt", ["docker", "diff", cid]),
        ("logs.txt", ["docker", "logs", "--timestamps", "--tail", "300", cid]),
    ):
        rc, out, err = run(cmd)
        if fname == "diff.txt":
            out = "\n".join(out.splitlines()[:5000])
        write_evidence(directory, fname, out + ("\n[stderr rc=%d]\n%s" % (rc, err) if rc or err else ""))
    return directory


def contain(alert, rule_id, falco_rule, cname):
    rc, out, err = run(["docker", "inspect", cname])
    if rc != 0:
        # Já recriado por um alerta anterior da mesma rajada: nada a fazer.
        log("debug", trigger_rule=rule_id, falco_rule=falco_rule, container=cname,
            detail="container não existe mais (provavelmente já recriado)")
        return
    info = json.loads(out)[0]
    cid = info["Id"]
    real_name = info.get("Name", "").lstrip("/") or cname
    labels = (info.get("Config") or {}).get("Labels") or {}
    privileged = bool((info.get("HostConfig") or {}).get("Privileged"))

    if real_name.startswith(PROTECTED_PREFIXES):
        log("skipped", trigger_rule=rule_id, falco_rule=falco_rule, container=real_name,
            detail="container do Wazuh: resposta automática não se aplica")
        return
    if not real_name.startswith(APP_PREFIX) and not privileged:
        log("skipped", trigger_rule=rule_id, falco_rule=falco_rule, container=real_name,
            detail="container fora do escopo do Lustre Decor")
        return

    # Vários alertas do mesmo evento chegam juntos (ex.: um secret por arquivo):
    # só o primeiro age sobre este container; os outros saem sem gastar a cota
    # do serviço nem disparar um segundo kill.
    if rate_limited("ctr:" + cid, 1, 600):
        log("debug", trigger_rule=rule_id, falco_rule=falco_rule, container=real_name,
            detail="container já tratado por outro alerta da mesma rajada")
        return

    swarm_service = labels.get("com.docker.swarm.service.name")
    compose_service = labels.get("com.docker.compose.service")
    key = swarm_service or (compose_service and "compose:" + compose_service) or real_name
    if rate_limited(key):
        log("skipped_rate_limit", trigger_rule=rule_id, falco_rule=falco_rule, container=real_name,
            service=key, detail="limite de %d recriações em %d min atingido; container mantido, "
            "investigar manualmente" % (RATE_MAX, RATE_WINDOW // 60))
        return

    # Congela os processos do atacante enquanto a evidência é coletada.
    paused = run(["docker", "pause", cid])[0] == 0
    try:
        evidence = collect_evidence(cid, real_name, alert)
    except OSError as e:
        evidence = "falha ao gravar evidência: %s" % e
    if paused:
        run(["docker", "unpause", cid])

    if swarm_service:
        rc, _, err = run(["docker", "kill", cid])
        method = "docker kill; o Swarm recria a tarefa do serviço %s" % swarm_service
    elif compose_service and labels.get("com.docker.compose.project"):
        cmd = ["docker", "compose", "-p", labels["com.docker.compose.project"]]
        for f in (labels.get("com.docker.compose.project.config_files") or "").split(","):
            if f:
                cmd += ["-f", f]
        cmd += ["up", "-d", "--force-recreate", "--no-deps", compose_service]
        wd = labels.get("com.docker.compose.project.working_dir")
        rc, _, err = run(cmd, cwd=wd if wd and os.path.isdir(wd) else None, timeout=180)
        method = "docker compose up --force-recreate %s" % compose_service
        if rc != 0:
            rc, _, err = run(["docker", "restart", cid])
            method += " (falhou; docker restart como alternativa)"
    else:
        # Container avulso (ex.: privilegiado criado pelo atacante): só derruba.
        rc, _, err = run(["docker", "kill", cid])
        method = "docker kill (container avulso, não é recriado)"

    if rc == 0:
        log("container_contained", trigger_rule=rule_id, falco_rule=falco_rule,
            container=real_name, service=key, detail=method, evidence=evidence)
    else:
        log("failed", trigger_rule=rule_id, falco_rule=falco_rule, container=real_name,
            service=key, detail="%s: %s" % (method, err.strip()[:300]), evidence=evidence)


# ---------------------------------------------------------------------------
# bloqueio de saída
# ---------------------------------------------------------------------------
def destination(alert):
    conn = falco_field(alert, "fd.name", "connection") or ""
    m = re.search(r"->(\d{1,3}(?:\.\d{1,3}){3}):\d+", conn)
    if not m:
        return None, conn
    try:
        ip = ipaddress.ip_address(m.group(1))
    except ValueError:
        return None, conn
    return (str(ip) if ip.is_global else None), conn


def iptables_rule(dst):
    return [CHAIN, "-d", dst, "-m", "comment", "--comment", COMMENT, "-j", "DROP"]


def egress(command, alert, rule_id, falco_rule, dst, conn):
    if run(["iptables", "-w", "-n", "-L", CHAIN])[0] != 0:
        log("failed", trigger_rule=rule_id, falco_rule=falco_rule, target=dst,
            detail="chain %s não encontrada (Docker usa iptables?)" % CHAIN)
        return
    present = run(["iptables", "-w", "-C"] + iptables_rule(dst))[0] == 0
    if command == "add":
        if not present:
            rc, _, err = run(["iptables", "-w", "-I"] + iptables_rule(dst))
            if rc != 0:
                log("failed", trigger_rule=rule_id, falco_rule=falco_rule, target=dst,
                    detail="iptables: %s" % err.strip()[:300])
                return
        log("egress_blocked", trigger_rule=rule_id, falco_rule=falco_rule, target=dst,
            container=falco_field(alert, "container.name", "container"), detail=conn)
    else:
        while present:
            run(["iptables", "-w", "-D"] + iptables_rule(dst))
            present = run(["iptables", "-w", "-C"] + iptables_rule(dst))[0] == 0
        log("egress_unblocked", trigger_rule=rule_id, falco_rule=falco_rule, target=dst)


# ---------------------------------------------------------------------------
# religar sensores
# ---------------------------------------------------------------------------
def restore_sensors(rule_id, falco_rule):
    # O alerta sai no exec do comando de parada, antes de ele terminar.
    time.sleep(15)
    restored, errors = [], []
    for unit in SENSOR_UNITS:
        rc, out, _ = run(["systemctl", "show", "-p", "LoadState", "--value", unit])
        state = out.strip()
        if state not in ("loaded", "masked"):
            continue
        if state == "masked":
            run(["systemctl", "unmask", unit])
        if run(["systemctl", "is-active", "--quiet", unit])[0] != 0:
            rc, _, err = run(["systemctl", "start", unit])
            (restored if rc == 0 else errors).append(unit if rc == 0 else "%s: %s" % (unit, err.strip()[:120]))
    if errors:
        log("failed", trigger_rule=rule_id, falco_rule=falco_rule, detail="; ".join(errors))
    elif restored:
        log("sensor_restored", trigger_rule=rule_id, falco_rule=falco_rule, detail=", ".join(restored))
    else:
        log("debug", trigger_rule=rule_id, falco_rule=falco_rule, detail="sensores já estavam ativos")


def restart_falco(rule_id):
    """Falco vivo mas sem emitir eventos (visto em 26/10/2026) não se resolve
    com `start`: precisa de restart. No máximo 1 por hora, para um falso
    positivo do batimento não virar laço de reinício."""
    if rate_limited("falco-restart", 1, 3600):
        log("skipped_rate_limit", trigger_rule=rule_id, detail="Falco já reiniciado na última hora; investigar manualmente")
        return
    unit = next((u for u in ("falco-modern-bpf", "falco")
                 if run(["systemctl", "show", "-p", "LoadState", "--value", u])[1].strip() == "loaded"), None)
    if not unit:
        log("failed", trigger_rule=rule_id, detail="serviço do Falco não encontrado")
        return
    rc, _, err = run(["systemctl", "restart", unit])
    if rc == 0:
        log("sensor_restored", trigger_rule=rule_id, falco_rule="batimento", detail="%s reiniciado" % unit)
    else:
        log("failed", trigger_rule=rule_id, detail="restart %s: %s" % (unit, err.strip()[:200]))


# ---------------------------------------------------------------------------
def main():
    try:
        msg = json.loads(sys.stdin.readline() or "{}")
    except ValueError:
        log("failed", detail="mensagem inválida do execd")
        return
    command = msg.get("command")
    alert = (msg.get("parameters") or {}).get("alert") or {}
    rule_id = str(lookup(alert, "rule.id") or "")
    falco_rule = str(lookup(alert, "data.rule") or "")
    action = decide(rule_id, falco_rule)
    if action is None or command not in ("add", "delete"):
        return

    if action == "egress":
        dst, conn = destination(alert)
        if not dst:
            if command == "add":
                log("skipped", trigger_rule=rule_id, falco_rule=falco_rule, detail=
                    "destino ausente ou não público, nada a bloquear (%s)" % conn)
            return
        if command == "add":
            answer = check_keys([dst])
            if answer != "continue":
                log("debug" if answer == "abort" else "failed", trigger_rule=rule_id,
                    falco_rule=falco_rule, target=dst,
                    detail="execd respondeu '%s' (abort = %s já bloqueado)" % (answer, dst))
                return
        egress(command, alert, rule_id, falco_rule, dst, conn)
        return

    if command != "add":
        return  # recriação e religar sensor não têm timeout

    if action == "falco_restart":
        keys = ["falco-restart"]
    elif action == "contain":
        cname = falco_field(alert, "container.name", "container")
        if not cname:
            log("skipped", trigger_rule=rule_id, falco_rule=falco_rule,
                detail="alerta sem container (comando no host); só alerta")
            return
        keys = [cname]
    else:
        keys = [falco_rule]

    answer = check_keys(keys)
    if answer != "continue":
        log("debug" if answer == "abort" else "failed", trigger_rule=rule_id,
            falco_rule=falco_rule, detail="execd respondeu '%s'" % answer)
        return

    detach()
    if action == "contain":
        contain(alert, rule_id, falco_rule, cname)
    elif action == "falco_restart":
        restart_falco(rule_id)
    else:
        restore_sensors(rule_id, falco_rule)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # nunca deixar traceback sem registro
        log("failed", detail="%s: %s" % (type(e).__name__, e))
