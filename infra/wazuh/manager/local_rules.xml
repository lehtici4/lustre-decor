<!--
  Regras do Lustre Decor (Wazuh manager). Faixa reservada: 100100-100499.
    1001xx  backend Django (log estruturado + recusas de mTLS do Gunicorn) e Postgres (10013x)
    1002xx  Falco (/var/log/falco/falco.json, nas duas VMs); 10022x = resposta
            ativa aos alertas do Falco (/var/ossec/logs/lustre-ar.log)
    1003xx  waf da DMZ (access log dedicado)
    1004xx  Fail2ban (nas duas VMs)
    1006xx  cofre OpenBao (/var/log/openbao/audit.log, só na .50)
  Decoders em local_decoder.xml. Cada regra aponta o teste do plano (T..) e a
  técnica ATT&CK. Linhas de exemplo para o wazuh-logtest em docs/wazuh.md.
-->

<group name="lustre_decor,backend,">

  <rule id="100100" level="0">
    <decoded_as>lustre-backend</decoded_as>
    <description>Lustre Decor backend: evento de log.</description>
  </rule>

  <!-- T08: força bruta no login. login_failed sai do sinal user_login_failed
       (senha errada na API, no admin ou no two-factor: reason=bad_credentials)
       e de requisição malformada nos endpoints de login/MFA
       (reason=invalid_request, HTTP 400) - VULN-06. -->
  <rule id="100101" level="5">
    <if_sid>100100</if_sid>
    <field name="message">^login_failed$</field>
    <description>Lustre Decor: falha de login ($(reason), origem $(origin)).</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100102" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100101</if_matched_sid>
    <same_field>origin</same_field>
    <description>Lustre Decor: 5 falhas de login em 2 min da mesma origem ($(origin)) - possível força bruta.</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100103" level="5">
    <if_sid>100100</if_sid>
    <field name="message">^mfa_failed$</field>
    <description>Lustre Decor: código MFA inválido (user_id $(user_id), origem $(origin)).</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100104" level="10" frequency="3" timeframe="300">
    <if_matched_sid>100103</if_matched_sid>
    <same_field>user_id</same_field>
    <description>Lustre Decor: repetidos códigos MFA inválidos para o mesmo usuário ($(user_id)) - senha provavelmente comprometida.</description>
    <mitre><id>T1110</id><id>T1078</id></mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100105" level="8">
    <if_sid>100100</if_sid>
    <field name="message">^request_throttled$</field>
    <description>Lustre Decor: requisição bloqueada pelo throttling do DRF ($(path), origem $(origin)).</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <!-- A01 / IDOR: acesso a carrinho, pedido ou loja de outro usuário -->
  <rule id="100106" level="10">
    <if_sid>100100</if_sid>
    <field name="message">^forbidden_object_access$</field>
    <description>Lustre Decor: tentativa de acessar objeto de outro usuário ($(model) $(object_id), user_id $(user_id)).</description>
    <mitre><id>T1078</id></mitre>
    <group>access_denied,lustre_object_probe,</group>
  </rule>

  <rule id="100107" level="12" frequency="3" timeframe="300">
    <if_matched_sid>100106</if_matched_sid>
    <same_field>user_id</same_field>
    <description>Lustre Decor: enumeração de objetos de outros usuários pelo mesmo usuário ($(user_id)).</description>
    <mitre><id>T1078</id></mitre>
    <group>access_denied,</group>
  </rule>

  <!-- VULN-07: ID inexistente em rota de dono (carrinho, pedido, painel do
       parceiro). Sozinho é ruído; em sequência, somado aos acessos a objeto
       de outro usuário (grupo lustre_object_probe), é enumeração. -->
  <rule id="100111" level="3">
    <if_sid>100100</if_sid>
    <field name="message">^object_not_found$</field>
    <description>Lustre Decor: objeto inexistente pedido ($(model) $(object_id), user_id $(user_id)).</description>
    <group>lustre_object_probe,</group>
  </rule>

  <rule id="100112" level="10" frequency="8" timeframe="120">
    <if_matched_group>lustre_object_probe</if_matched_group>
    <same_field>user_id</same_field>
    <description>Lustre Decor: enumeração de IDs pelo mesmo usuário ($(user_id)) - 8 objetos inexistentes ou de terceiros em 2 min.</description>
    <mitre><id>T1213</id><id>T1078</id></mitre>
    <group>access_denied,</group>
  </rule>

  <!-- VULN-07: usuário autenticado sem o papel exigido pedindo rota de
       parceiro (API) ou do Django Admin - tentativa de escalonamento. -->
  <rule id="100113" level="8">
    <if_sid>100100</if_sid>
    <field name="message">^privileged_route_denied$</field>
    <description>Lustre Decor: usuário $(user_id) tentou rota privilegiada sem permissão ($(path)).</description>
    <mitre><id>T1078</id></mitre>
    <group>access_denied,privilege_escalation,</group>
  </rule>

  <rule id="100114" level="12" frequency="3" timeframe="300">
    <if_matched_sid>100113</if_matched_sid>
    <same_field>user_id</same_field>
    <description>Lustre Decor: repetidas tentativas de rota privilegiada pelo mesmo usuário ($(user_id)) - escalonamento de privilégio.</description>
    <mitre><id>T1078</id><id>T1068</id></mitre>
    <group>access_denied,privilege_escalation,</group>
  </rule>

  <rule id="100108" level="3">
    <if_sid>100100</if_sid>
    <field name="message">^permission_denied$</field>
    <description>Lustre Decor: acesso negado ($(path)).</description>
  </rule>

  <rule id="100109" level="3">
    <if_sid>100100</if_sid>
    <field name="message">^admin_action$</field>
    <description>Lustre Decor: alteração pelo Django Admin ($(action) $(model) $(object_id), user_id $(user_id)).</description>
    <group>audit,</group>
  </rule>

  <rule id="100110" level="3">
    <if_sid>100100</if_sid>
    <field name="message">^login_succeeded$</field>
    <description>Lustre Decor: login concluído (user_id $(user_id)).</description>
    <group>authentication_success,</group>
  </rule>

  <!--
    mTLS: o Gunicorn recusou uma conexão ao backend (sem certificado de
    cliente, certificado de outra CA, HTTP puro, TLS antigo). O único cliente
    legítimo é o waf — isto indica alguém falando direto com 192.168.9.50:8000
    (DMZ comprometida, varredura interna, regra de pfSense aberta).
  -->
  <rule id="100120" level="10">
    <if_sid>100100</if_sid>
    <match>Invalid request from ip=</match>
    <regex type="pcre2">\[SSL: [A-Z_]+\]</regex>
    <description>Lustre Decor: conexão ao backend recusada pelo mTLS (cliente sem certificado válido da CA interna).</description>
    <mitre><id>T1190</id><id>T1021</id></mitre>
  </rule>

</group>

<group name="lustre_decor,postgres,">

  <!-- Postgres: só o backend (TLS verify-full + senha) deveria conectar -->
  <rule id="100130" level="0">
    <decoded_as>lustre-postgres</decoded_as>
    <description>Lustre Decor Postgres: evento de log.</description>
  </rule>

  <rule id="100131" level="8">
    <if_sid>100130</if_sid>
    <match>pg_hba.conf rejects connection</match>
    <description>Postgres recusou conexão pelo pg_hba.conf (sem TLS ou origem/usuário não permitidos).</description>
    <mitre><id>T1557</id><id>T1078</id></mitre>
  </rule>

  <rule id="100132" level="7">
    <if_sid>100130</if_sid>
    <match>password authentication failed</match>
    <description>Postgres: falha de autenticação por senha.</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100133" level="12" frequency="5" timeframe="120">
    <if_matched_sid>100132</if_matched_sid>
    <description>Postgres: repetidas falhas de senha - possível força bruta contra o banco.</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failures,</group>
  </rule>

</group>

<group name="lustre_decor,falco,">

  <!-- Alertas do Falco em JSON (json_output), um por linha -->
  <rule id="100200" level="3">
    <decoded_as>json</decoded_as>
    <field name="rule">\.+</field>
    <field name="priority">\.+</field>
    <field name="output">\.+</field>
    <description>Falco: $(rule).</description>
  </rule>

  <rule id="100201" level="5">
    <if_sid>100200</if_sid>
    <field name="priority" type="pcre2">(?i)^notice$</field>
    <description>Falco (notice): $(rule).</description>
  </rule>

  <rule id="100202" level="10">
    <if_sid>100200</if_sid>
    <field name="priority" type="pcre2">(?i)^warning$</field>
    <description>Falco (warning): $(rule).</description>
  </rule>

  <rule id="100203" level="13">
    <if_sid>100200</if_sid>
    <field name="priority" type="pcre2">(?i)^(error|critical|alert|emergency)$</field>
    <description>Falco ($(priority)): $(rule).</description>
  </rule>

  <!-- Batimento do próprio Falco (metrics a cada 15 min): sem alerta -->
  <rule id="100205" level="0">
    <if_sid>100200</if_sid>
    <field name="rule">^Falco internal: metrics</field>
    <description>Falco: batimento (metrics snapshot).</description>
  </rule>

  <!-- Sensor travado ou parado (comando lustre-falco-vivo do agente) -->
  <rule id="100230" level="12">
    <if_sid>530</if_sid>
    <match>^ossec: output: 'lustre-falco-vivo'</match>
    <regex type="pcre2">falco_vivo=0|estado=(?!active)</regex>
    <description>Falco sem emitir eventos há mais de 1 h ou serviço parado: sensor de runtime cego.</description>
    <mitre><id>T1562.001</id></mitre>
  </rule>

  <!-- Regras próprias do Lustre Decor (infra/falco/rules.d), com ATT&CK -->
  <rule id="100210" level="12">
    <if_sid>100202,100203</if_sid>
    <field name="rule">^LustreDecor - Shell iniciado em container</field>
    <description>Falco: shell interativo em container do Lustre Decor (T03).</description>
    <mitre><id>T1059</id><id>T1609</id></mitre>
  </rule>

  <rule id="100211" level="14">
    <if_sid>100203</if_sid>
    <field name="rule" type="pcre2">^LustreDecor - (Acesso ao Docker socket|Container privilegiado)</field>
    <description>Falco: tentativa de escape para o host - $(rule).</description>
    <mitre><id>T1611</id></mitre>
  </rule>

  <rule id="100212" level="12">
    <if_sid>100202</if_sid>
    <field name="rule">^LustreDecor - Docker secret lido</field>
    <description>Falco: Docker secret lido por processo inesperado (T04).</description>
    <mitre><id>T1552.001</id></mitre>
  </rule>

  <rule id="100213" level="14">
    <if_sid>100203</if_sid>
    <field name="rule" type="pcre2">^LustreDecor - (Tentativa de parar sensor|Log ou evidencia apagado|Log de seguranca truncado)</field>
    <description>Falco: evasão de defesa - $(rule) (T05).</description>
    <mitre><id>T1562.001</id><id>T1070.004</id></mitre>
  </rule>

  <rule id="100214" level="12">
    <if_sid>100202</if_sid>
    <field name="rule" type="pcre2">^LustreDecor - (Conexao de saida|Ferramenta de rede)</field>
    <description>Falco: possível exfiltração a partir de container - $(rule) (T06).</description>
    <mitre><id>T1048</id><id>T1105</id></mitre>
  </rule>

</group>

<!--
  Resposta ativa (infra/wazuh/agent/active-response/lustre-falco-ar). Cada
  ação do script vira uma linha JSON em /var/ossec/logs/lustre-ar.log no host,
  coletada pelo agente: o dashboard mostra o alerta do Falco E a resposta.
  Comandos e regras que disparam a resposta: <active-response> no ossec.conf.
-->
<group name="lustre_decor,active_response,">

  <rule id="100220" level="0">
    <decoded_as>json</decoded_as>
    <field name="lustre_ar">\.+</field>
    <description>Lustre Decor: registro da resposta ativa.</description>
  </rule>

  <rule id="100221" level="10">
    <if_sid>100220</if_sid>
    <field name="lustre_ar">^container_contained$</field>
    <description>Resposta ativa: container $(container) recriado a partir da imagem após "$(falco_rule)" (evidência em $(evidence)).</description>
  </rule>

  <rule id="100222" level="10">
    <if_sid>100220</if_sid>
    <field name="lustre_ar">^egress_blocked$</field>
    <description>Resposta ativa: saída dos containers para $(target) bloqueada por 1 h ($(container)).</description>
  </rule>

  <rule id="100223" level="3">
    <if_sid>100220</if_sid>
    <field name="lustre_ar">^egress_unblocked$</field>
    <description>Resposta ativa: fim do bloqueio de saída para $(target).</description>
  </rule>

  <rule id="100224" level="10">
    <if_sid>100220</if_sid>
    <field name="lustre_ar">^sensor_restored$</field>
    <description>Resposta ativa: sensor religado após tentativa de parada ($(detail)).</description>
  </rule>

  <!-- A resposta NÃO aconteceu: precisa de alguém olhando -->
  <rule id="100225" level="12">
    <if_sid>100220</if_sid>
    <field name="lustre_ar" type="pcre2">^(failed|skipped_rate_limit)$</field>
    <description>Resposta ativa NÃO executada ($(lustre_ar)): $(detail).</description>
  </rule>

  <rule id="100226" level="3">
    <if_sid>100220</if_sid>
    <field name="lustre_ar">^skipped$</field>
    <description>Resposta ativa ignorada: $(detail).</description>
  </rule>

</group>

<!--
  Cofre (OpenBao): log de auditoria em JSON. Cada operação gera uma linha
  "request" e uma "response"; as regras olham só a "response", que traz o
  pedido, quem pediu (auth.display_name) e o erro, se houve. Valores de
  segredo chegam como HMAC. ORDEM IMPORTA: as regras de erro vêm antes da de
  leitura, porque o Wazuh fica com o primeiro filho que casar.
-->
<group name="lustre_decor,cofre,">

  <rule id="100600" level="0">
    <decoded_as>json</decoded_as>
    <field name="type">^response$</field>
    <field name="request.path">\.+</field>
    <description>Cofre: operação registrada na auditoria.</description>
  </rule>

  <rule id="100605" level="8">
    <if_sid>100600</if_sid>
    <field name="request.path">^auth/userpass/login/</field>
    <field name="error">\.+</field>
    <description>Cofre: falha de login ($(request.path), origem $(request.remote_address)).</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100606" level="12" frequency="5" timeframe="120">
    <if_matched_sid>100605</if_matched_sid>
    <same_field>request.remote_address</same_field>
    <description>Cofre: 5 falhas de login em 2 min da mesma origem ($(request.remote_address)) - possível força bruta.</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100603" level="8">
    <if_sid>100600</if_sid>
    <field name="error" type="pcre2">permission denied</field>
    <description>Cofre: acesso negado a $(request.path) ($(auth.display_name), origem $(request.remote_address)).</description>
    <mitre><id>T1555</id></mitre>
    <group>access_denied,</group>
  </rule>

  <rule id="100604" level="12" frequency="5" timeframe="120">
    <if_matched_sid>100603</if_matched_sid>
    <same_field>request.remote_address</same_field>
    <description>Cofre: acessos negados repetidos da mesma origem ($(request.remote_address)) - enumeração de segredos.</description>
    <mitre><id>T1555</id></mitre>
    <group>access_denied,</group>
  </rule>

  <rule id="100607" level="12">
    <if_sid>100600</if_sid>
    <field name="auth.display_name">^root$</field>
    <description>Cofre: operação com o ROOT TOKEN ($(request.operation) $(request.path)).</description>
    <mitre><id>T1078</id></mitre>
  </rule>

  <rule id="100609" level="10">
    <if_sid>100600</if_sid>
    <field name="request.path" type="pcre2">^sys/(seal|policies/acl/|auth/|mounts/|audit)</field>
    <field name="request.operation" type="pcre2">^(create|update|delete)$</field>
    <description>Cofre: mudança de configuração ($(request.operation) $(request.path) por $(auth.display_name)).</description>
    <mitre><id>T1098</id></mitre>
  </rule>

  <rule id="100608" level="6">
    <if_sid>100600</if_sid>
    <field name="request.path">^ssh-client-signer/sign/</field>
    <description>Cofre: certificado SSH emitido para $(auth.display_name).</description>
  </rule>

  <rule id="100602" level="5">
    <if_sid>100600</if_sid>
    <field name="request.path" type="pcre2">^lustre/(data|metadata)/</field>
    <field name="request.operation" type="pcre2">^(create|update|patch|delete)$</field>
    <description>Cofre: segredo alterado ($(request.operation) $(request.path) por $(auth.display_name)).</description>
    <group>audit,</group>
  </rule>

  <rule id="100601" level="3">
    <if_sid>100600</if_sid>
    <field name="request.path">^lustre/data/</field>
    <field name="request.operation">^read$</field>
    <description>Cofre: segredo lido ($(request.path) por $(auth.display_name)).</description>
    <group>audit,</group>
  </rule>

</group>

<group name="lustre_decor,waf,web,">

  <rule id="100300" level="0">
    <decoded_as>lustre-waf</decoded_as>
    <description>Lustre Decor waf: requisição.</description>
  </rule>

  <!-- upstream "-": resposta gerada no próprio waf, não no Django -->
  <rule id="100301" level="6">
    <if_sid>100300</if_sid>
    <status>^403$</status>
    <field name="upstream_status">^-$</field>
    <description>WAF (ModSecurity/CRS) bloqueou requisição de $(srcip): $(method) $(url).</description>
    <mitre><id>T1190</id></mitre>
    <group>attack,</group>
  </rule>

  <rule id="100302" level="10" frequency="10" timeframe="60">
    <if_matched_sid>100301</if_matched_sid>
    <same_srcip />
    <description>WAF: 10 bloqueios em 1 min da mesma origem ($(srcip)) - varredura ou ataque automatizado (T07).</description>
    <mitre><id>T1190</id><id>T1595</id></mitre>
    <group>attack,</group>
  </rule>

  <rule id="100303" level="5">
    <if_sid>100300</if_sid>
    <status>^429$</status>
    <field name="upstream_status">^-$</field>
    <description>WAF: limite de taxa (limit_req) atingido por $(srcip) em $(url).</description>
    <mitre><id>T1110</id></mitre>
  </rule>

  <!-- VULN-06, visão da borda: falha de autenticação (401 do Django) ou
       requisição de login malformada (400 do Django ou do próprio waf). Fica
       independente do log do backend: se o salto até a .50 falhar, a DMZ
       ainda registra a força bruta. -->
  <rule id="100305" level="5">
    <if_sid>100300</if_sid>
    <status type="pcre2">^40[01]$</status>
    <url type="pcre2">^/api/v1/auth/(?:login|mfa/verify)/$</url>
    <description>WAF: falha de autenticação de $(srcip) em $(url) (HTTP $(status)).</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100306" level="10" frequency="8" timeframe="120">
    <if_matched_sid>100305</if_matched_sid>
    <same_srcip />
    <description>WAF: 8 falhas de autenticação em 2 min da mesma origem ($(srcip)) - força bruta (T08).</description>
    <mitre><id>T1110.001</id><id>T1110.003</id></mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="100307" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100303</if_matched_sid>
    <same_srcip />
    <description>WAF: $(srcip) insiste depois do limite de taxa (5x 429 em 2 min) - ataque automatizado.</description>
    <mitre><id>T1110</id><id>T1499</id></mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- 502 com upstream 502: o waf não conseguiu falar com o backend (inclui falha do handshake mTLS) -->
  <rule id="100304" level="7">
    <if_sid>100300</if_sid>
    <status>^502$</status>
    <description>WAF: backend indisponível ou handshake mTLS falhou ($(url)).</description>
  </rule>

</group>

<group name="lustre_decor,fail2ban,">

  <rule id="100400" level="0">
    <decoded_as>lustre-fail2ban</decoded_as>
    <description>Fail2ban: ação registrada.</description>
  </rule>

  <rule id="100401" level="8">
    <if_sid>100400</if_sid>
    <field name="f2b_action" type="pcre2">^(Ban|Restore Ban)$</field>
    <description>Fail2ban: $(srcip) banido pela jail $(jail).</description>
    <mitre><id>T1110</id></mitre>
    <group>active_response,</group>
  </rule>

  <rule id="100402" level="3">
    <if_sid>100400</if_sid>
    <field name="f2b_action">^Unban$</field>
    <description>Fail2ban: $(srcip) desbanido (jail $(jail)).</description>
  </rule>

  <rule id="100403" level="12">
    <if_sid>100401</if_sid>
    <field name="jail">^recidive$</field>
    <description>Fail2ban: $(srcip) reincidente banido por longo prazo (recidive).</description>
    <mitre><id>T1110</id></mitre>
  </rule>

</group>
